# Backend API (no trailing slash)
# Yerel backend: http://localhost:8080
# Canlı backend: https://panel.ogtasis.com veya https://mobile.ogtasis.com
# Yerel Expo web (localhost:8081) icin canli backend CORS'ta izinli.
# Chrome'da mobil cihaz emulasyonu acikken panel API'si yonlendirme alabilir;
# bu durumda mobile.ogtasis.com kullanmak daha guvenlidir.
EXPO_PUBLIC_API_URL=https://panel.ogtasis.com

# EAS project id (expo push token icin). `eas init` sonrasi app.json extra.eas.projectId ile de gelebilir.
# EXPO_PUBLIC_EAS_PROJECT_ID=
